# Kumbh Saathi - Environment Configuration
# Copy this file to .env and configure your keys if available.
# The application has zero-config fallbacks for maps and AI so it can be demonstrated immediately even without keys!

# Google Maps JavaScript API key (optional - interactive OpenStreetMap/Leaflet fallback is built-in)
VITE_GOOGLE_MAPS_API_KEY=

# Google Gemini API key (optional - intelligent offline multilingual engine is built-in)
VITE_GEMINI_API_KEY=
